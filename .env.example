# Copy to .env (never commit real keys) and export before running `idengine serve`
# or `docker compose up`. Every setting can also be given as IDE_<SECTION>__<FIELD>.

# Where SQLite, original files (blobs) and indexes are stored.
IDE_DATA_DIR=./var

# API keys as key:role (roles: reader, writer, admin). Keys must be >= 8 characters.
IDE_API_KEYS=change-me-admin-key:admin,change-me-reader-key:reader
# Set to false only for local experiments on a trusted machine.
IDE_AUTH_ENABLED=true

IDE_LOG_LEVEL=INFO

# Optional TOML config file (see examples/engine.toml).
# IDE_CONFIG_FILE=./examples/engine.toml

# Background workers for ingestion/summaries/reindex jobs.
IDE_JOBS__WORKERS=2

# Vector index: flat | ivf | hnsw. Embeddings: hashing | lsa | sentence-transformers.
IDE_INDEX__KIND=hnsw
IDE_EMBEDDINGS__PROVIDER=hashing

# LLM adapter. "extractive" is local, deterministic and needs no network.
# Optional (disabled by default) HTTP backends:
#   IDE_LLM_PROVIDER=ollama   IDE_LLM_BASE_URL=http://localhost:11434   IDE_LLM_MODEL=llama3.1
#   IDE_LLM_PROVIDER=openai   IDE_LLM_BASE_URL=http://localhost:8080/v1 IDE_LLM_API_KEY=...
IDE_LLM_PROVIDER=extractive

# Request limits.
IDE_INGEST__MAX_FILE_BYTES=20971520
IDE_API__MAX_REQUEST_BYTES=26214400
IDE_API__RATE_LIMIT_PER_MINUTE=600
